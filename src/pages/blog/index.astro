---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import Search from '../../components/Search.astro';
import QuickActions from '../../components/QuickActions.astro';
import ThemeSettings from '../../components/ThemeSettings.astro';
import siteConfig from '../../../site.config.mjs';
import { getPostTitle } from '../../utils/content';

const posts = await getCollection('blog');
posts.sort((a, b) => (b.data.date?.valueOf() || 0) - (a.data.date?.valueOf() || 0));

const tagCounts = new Map<string, number>();
posts.forEach(post => {
  post.data.tags.forEach(tag => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

const directories = new Map<string, string>();
posts.forEach(post => {
  const parts = post.id.split('/');
  if (parts.length > 1) {
    const slugDir = parts[0];
    const properDir = post.data.originalDirectory || `${parts[0].charAt(0).toUpperCase()}${parts[0].slice(1)}`;
    directories.set(slugDir, properDir);
  }
});

const title = siteConfig.TITLE;
const description = "Blog Posts and Articles";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": title,
  "description": description,
  "url": Astro.url.href
};
---

<BaseLayout
  title={title}
  description={description}
  type="CollectionPage"
  structuredData={structuredData}
>
    <main>
        <div class="landing-header blog-head">
            <h1>writing</h1>
            <Search />
        </div>

        <div id="no-results" class="no-results" style="display: none;">
            No posts found matching your search.
        </div>

        {directories.size > 0 && (
            <section class="section">
                <div class="section-label">~ categories</div>
                <div class="filters">
                    {Array.from(directories).map(([slug, name]) => (
                        <a class="chip" href={`/blog/${slug}/`}>{name}</a>
                    ))}
                </div>
            </section>
        )}

        {tagCounts.size > 0 && (
            <section class="section">
                <div class="section-label">~ tags</div>
                <div class="filters">
                    {Array.from(tagCounts.entries())
                      .sort((a, b) => b[1] - a[1])
                      .slice(0, 10)
                      .map(([tag, count]) => (
                        <a class="chip" href={`/blog/tags/${tag}/`}>{tag} <span style="opacity:.6">({count})</span></a>
                    ))}
                </div>
            </section>
        )}

        {posts.length > 0 && (
            <section class="section">
                <div class="section-label">~ posts</div>
                <ul class="blog-list" id="blog-list">
                    {posts.map(post => (
                        <li class="post" data-title={getPostTitle(post)}>
                            <BlogCard post={post} />
                        </li>
                    ))}
                </ul>
            </section>
        )}
    </main>
    <QuickActions showRSS rssURL="/blog/feed.xml" backHref="/" backLabel="Back to home">
        <ThemeSettings />
    </QuickActions>
</BaseLayout>
