---
import BaseLayout from './BaseLayout.astro';
import QuickActions from '../components/QuickActions.astro';
import ThemeSettings from '../components/ThemeSettings.astro';
import type { CollectionEntry } from 'astro:content';
import { parseLandingContent } from '../utils/content';

export interface Props {
  entry: CollectionEntry<'landing'>;
  recentPosts?: Array<{ title: string; link: string; commitHash?: string; commitURL?: string }>;
}

const { entry, recentPosts = [] } = Astro.props;
const { title, description } = entry.data;

const { headerHtml, sections, links } = parseLandingContent(entry.body);

const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": title,
  "url": Astro.site,
  "description": description
};
---

<BaseLayout
  title={title}
  description={description}
  type="website"
  structuredData={structuredData}
>
  <main>
    <div class="landing-header" set:html={headerHtml} />

    {sections.map(section => (
      <section class="section">
        <div class="section-label">~ {section.label}</div>
        <div class={`section-content section-${section.label}`} set:html={section.html} />
      </section>
    ))}

    {links.length > 0 && (
      <section class="section">
        <div class="section-label">~ elsewhere</div>
        <div class="link-row">
          {links.map(link => (
            <a href={link.url} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.name}</a>
          ))}
        </div>
      </section>
    )}

    {recentPosts.length > 0 && (
      <section class="section">
        <div class="section-label">~ recent</div>
        <ul class="recent-posts">
          {recentPosts.map(post => (
            <li>
              {post.commitHash && (post.commitURL
                ? <a href={post.commitURL} class="commit-hash" target="_blank" rel="noopener noreferrer">{post.commitHash}</a>
                : <span class="commit-hash">{post.commitHash}</span>)}
              <a href={post.link}>{post.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>

  <QuickActions>
    <ThemeSettings />
  </QuickActions>
</BaseLayout>
