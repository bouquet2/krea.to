---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import QuickActions from '../components/QuickActions.astro';
import ThemeSettings from '../components/ThemeSettings.astro';
import type { CollectionEntry } from 'astro:content';
import { getPostTitle } from '../utils/content';
import { getPostComputedMetadataById } from '../utils/postMetadata';
import { getReadingTime } from '../utils/readingTime';
import { render } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'blog'>;
  relatedPosts?: CollectionEntry<'blog'>[];
}

const { entry, relatedPosts = [] } = Astro.props;
const { title: frontmatterTitle, description, author, date, tags, readTime } = entry.data;
const effectiveReadTime = readTime ?? getReadingTime(entry.body ?? '');
const title = frontmatterTitle || getPostTitle(entry);
const { Content } = await render(entry);

const computed = getPostComputedMetadataById(entry.id);
const rawDate = date ?? (computed?.commitDate ? new Date(computed.commitDate) : undefined);
const effectiveDate = rawDate && !Number.isNaN(rawDate.getTime()) ? rawDate : undefined;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  ...(description && { "description": description }),
  ...(author && { "author": { "@type": "Person", "name": author } }),
  ...(date && { "datePublished": date.toISOString() }),
  "url": Astro.url.href
};
---

<BaseLayout
  title={title}
  description={description}
  author={author}
  date={date?.toISOString()}
  type="article"
  structuredData={structuredData}
>
  <main>
    <article class="blog-post">
      <header>
        <h1>{title}</h1>
        <p class="post-meta">
          {tags.length > 0 && <TagList tags={tags} />}
          {tags.length > 0 && (author || effectiveDate || effectiveReadTime) && <span class="meta-separator">·</span>}
          {author && <span>by {author}</span>}
          {author && (effectiveDate || effectiveReadTime) && <span class="meta-separator">·</span>}
          {effectiveDate && <time datetime={effectiveDate.toISOString()}>{effectiveDate.toLocaleDateString()}</time>}
          {effectiveDate && effectiveReadTime && <span class="meta-separator">·</span>}
          {effectiveReadTime && <span>{effectiveReadTime}</span>}
        </p>
      </header>
      <div class="content">
        <Content />
      </div>
    </article>

    {relatedPosts.length > 0 && (
      <aside class="related-posts">
        <div class="section-label">~ related</div>
        <ul>
          {relatedPosts.map(post => (
            <li>
              <a href={`/blog/${post.id.replace(/\.md$/, '')}/`}>{getPostTitle(post)}</a>
              {post.data.tags.length > 0 && (
                <span class="related-tags">{post.data.tags.join(', ')}</span>
              )}
            </li>
          ))}
        </ul>
      </aside>
    )}
  </main>
  <QuickActions showRSS rssURL="/blog/feed.xml" backHref="/blog/" backLabel="Back to blog">
    <ThemeSettings />
  </QuickActions>
</BaseLayout>
